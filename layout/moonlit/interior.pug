- var globalPageType = getPageType(page, is_home)
- var pageType = globalPageType === 'post' ? 'post' : 'page'
- var isLetterPost = globalPageType === 'post'
- var isShortNote = isLetterPost && notebook_stats(page.content).words < 300 && !/<h[1-6][ >]/i.test(page.content)
- var top_img = false
if isLetterPost
  - page.title = moonlit_note(page).title
doctype html
html(lang=config.language data-theme=theme.display_mode)
  head
    include ../../node_modules/hexo-theme-butterfly/layout/includes/head.pug
  body.moonlit-interior(class=isLetterPost ? (isShortNote ? 'letter-reader letter-short' : 'letter-reader') : 'letter-directory')
    a.moonlit-skip(href='#content-inner') 跳到正文
    #body-wrap(class=pageType)
      header#page-header.not-top-img
        include navigation.pug
      main#content-inner.layout.letter-layout(class=isLetterPost ? '' : 'hide-aside')
        block content
        if isLetterPost && showToc
          aside#aside-content.letter-aside(aria-label='文章目录')
            .sticky_layout
              - page.toc_number = false
              include ../../node_modules/hexo-theme-butterfly/layout/includes/widget/card_post_toc.pug
      footer#footer.letter-footer
        a(href=url_for('/about/')) ☾ Catailor
        span= ' · ' + date(Date.now(), 'YYYY')
        a(href=url_for('/archives/')) 翻阅旧时光 ↗
    include ../../node_modules/hexo-theme-butterfly/layout/includes/rightside.pug
    if isLetterPost
      nav.letter-page-actions(aria-label='文章导航')
        button(type='button' data-reader-top hidden aria-label='回到顶部' title='回到顶部')
          svg(width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true' focusable='false')
            path(d='m6 11 6-6 6 6M12 5v14' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round')
          span 顶部
        a(href=url_for('/archives/') data-article-back aria-label='返回手记' title='返回手记')
          svg(width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true' focusable='false')
            path(d='m11 6-6 6 6 6M5 12h14' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round')
          span(data-back-label) 手记
    include ../../node_modules/hexo-theme-butterfly/layout/includes/additional-js.pug
