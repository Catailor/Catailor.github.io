extends interior.pug

block content
  - const note = moonlit_note(page)
  #post.letter-post
    header.letter-post-header
      nav.letter-breadcrumb(aria-label='当前位置')
        a(href=url_for('/')) 小站
        span /
        a(href=url_for('/archives/')) 手记
        span /
        span= note.topic
      .letter-post-overline
        span.moonlit-eyebrow= note.kind === 'life' ? 'LIFE, IN SMALL PIECES' : 'NOTES ALONG THE WAY'
        span.letter-post-mark(aria-hidden='true')= note.symbol
      h1.post-title= note.title
      if note.summary && !isShortNote
        p.letter-post-deck= note.summary
      .letter-byline
        a(href=url_for('/about/'))
          img(src=url_for('/img/moonlit/avatar.webp') alt='' width='28' height='28')
          | Catailor
        span ·
        time(datetime=date_xml(page.date))= date(page.date, 'YYYY.MM.DD')
        span.letter-topic= note.topic
      .letter-reading-actions
        if showToc
          button.letter-toc-toggle(type='button' data-toc-toggle aria-expanded='false' aria-controls='aside-content' hidden) 目录
        details.letter-tools(data-reader-tools hidden)
          summary 阅读设置
          .letter-tools-panel
            .letter-type-controls(role='group' aria-label='正文字号')
              button(type='button' data-font-size='16' aria-pressed='false') 小
              button(type='button' data-font-size='18' aria-pressed='true') 标准
              button(type='button' data-font-size='20' aria-pressed='false') 大
            button.letter-focus-toggle(type='button' data-focus-toggle aria-pressed='false') 开启专注阅读
            p.letter-tools-hint 按 Esc 退出专注模式
    article#article-container.container.post-content!= page.content
    nav.letter-post-neighbors(aria-label='相邻手记' class=page.categories.toArray().some(c => c.name === '日语学习') ? 'letter-japanese-neighbors' : '')
      if page.prev
        a(href=url_for(page.prev.path))
          small ← 较早的一页
          strong= moonlit_note(page.prev).title
      if page.next
        a(href=url_for(page.next.path))
          small 较新的一页 →
          strong= moonlit_note(page.next).title
    footer.letter-colophon
      .letter-post-tags
        each tag in page.tags.toArray()
          a(href=url_for(tag.path))= '# ' + tag.name
      .letter-footer-actions
        a.letter-return(href=url_for('/archives/') data-article-back) ← 返回手记
        button.letter-copy(type='button' data-copy-link hidden) 复制链接
        span.letter-copy-status(role='status' aria-live='polite')
      p.letter-license
        | 本文采用
        a(href=theme.post_copyright.license_url target='_blank' rel='noopener noreferrer')= theme.post_copyright.license
        |  许可，转载请注明出处。
