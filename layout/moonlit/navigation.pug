nav#nav
  span#blog-info
    a.nav-site-title(href=url_for('/'))
      span.moonlit-brand-moon(aria-hidden='true') ☾
      span.site-name Catailor
  #menus
    .moonlit-links
      a(href=url_for('/') class=globalPageType === 'home' ? 'is-current' : '') 首页
      a(href=url_for('/archives/') class=globalPageType === 'archive' ? 'is-current' : '') 手记
      a(href=url_for('/about/')) 关于
      a(href=url_for('/search/') title='搜索手记，快捷键 /') 搜索
      details.letter-explore
        summary 更多
          svg.letter-menu-chevron(width='10' height='10' viewBox='0 0 12 12' fill='none' aria-hidden='true' focusable='false')
            path(d='M2.5 4.25 6 7.75 9.5 4.25' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
        .letter-menu
          a(href=url_for('/topics/')) 学习专题
          if site.data.notebook.moments.length
            a(href=url_for('/moments/')) 碎碎念
          if site.data.notebook.friends.length
            a(href=url_for('/friends/')) 友链
          a(href=url_for('/random/')) 随机漫游
          a(href=url_for('/private/')) 私人手记
      button.moonlit-theme(type='button' aria-label='切换日夜模式') ☾
