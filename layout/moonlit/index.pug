- var globalPageType = 'home'
- var pageType = 'page'
- var moonlit = site.data.moonlit
- var notebook = site.data.notebook || {}
- var allNotes = moonlit_posts()
- var featured = allNotes.find(p => p.featured)
- var rows = allNotes.filter(p => p !== featured)
- var shelf = moonlit_shelf(allNotes)
- var since = moonlit_since()
doctype html
html(lang=config.language data-theme=theme.display_mode)
  head
    include ../../node_modules/hexo-theme-butterfly/layout/includes/head.pug
    link(rel='preload' as='image' href=url_for('/img/moonlit/hero.webp'))
  body.moonlit-home
    != partial('includes/loading/index', {}, {cache: true})
    != partial('includes/sidebar', {}, {cache: true})
    a.moonlit-skip(href='#notes') 跳到手记
    #body-wrap.page
      header#page-header.moonlit-hero
        .moonlit-scene(aria-hidden='true')
        .moonlit-wash(aria-hidden='true')
        .moonlit-stars(aria-hidden='true')
          each n in [1, 2, 3, 4, 5, 6, 7, 8]
            span
        include navigation.pug
        .moonlit-hero-inner
          .moonlit-hero-copy
            a.moonlit-hello(href=url_for('/about/'))
              img(src=url_for('/img/moonlit/avatar.webp') alt='' width='28' height='28')
              span Catailor
              span.moonlit-hello-bio= moonlit.bio
            h1 在月光下，<br>记录一些小事。
            p.moonlit-intro= moonlit.intro
            .moonlit-hero-actions
              a.moonlit-button.is-primary(href='#notes')
                | 开始阅读
                +icon('down', 16)
              a.moonlit-button(href=url_for('/topics/'))
                | 学习专题
                +icon('right', 16)
            ul.moonlit-facts
              li
                strong= allNotes.length
                |  篇手记
              li
                strong= shelf.length
                |  个专题
              li.moonlit-moon-phase(data-moon-phase hidden)
                svg(width='15' height='15' viewBox='0 0 24 24' aria-hidden='true' focusable='false')
                  circle(cx='12' cy='12' r='9' fill='currentColor' opacity='.2')
                  path(data-moon-lit fill='currentColor' d='')
                | 今夜
                strong(data-moon-name)
        if notebook.now && notebook.now.learning
          a.moonlit-now(href=url_for('/about/') + '#now')
            span.moonlit-now-label 最近在学
            span.moonlit-now-text= notebook.now.learning
      main#content-inner.moonlit-main
        if featured
          section.moonlit-section(aria-labelledby='featured-title')
            .moonlit-section-head
              h2#featured-title 精选
            article.moonlit-featured(data-kind=featured.kind)
              a.moonlit-cover(href=featured.href tabindex='-1' aria-hidden='true' class=featured.cover ? '' : 'letter-art letter-art-' + featured.art)
                if featured.cover
                  img(src=featured.cover alt='' loading='lazy' decoding='async' width='760' height='480')
                else
                  span.letter-art-symbol= featured.symbol
                  span.letter-art-topic= featured.topic
              .moonlit-card-copy
                .moonlit-meta
                  span.moonlit-topic= featured.topic
                  time(datetime=featured.iso)= featured.date
                h3
                  a(href=featured.href)= featured.title
                p= featured.summary
                a.moonlit-read(href=featured.href aria-label='阅读：' + featured.title)
                  span= featured.words >= 300 ? '约 ' + featured.minutes + ' 分钟读完' : '读这一篇'
                  +icon('arrow', 16)
        section#notes.moonlit-section(aria-labelledby='notes-title')
          .moonlit-section-head
            h2#notes-title 最近文章
            .moonlit-filters(role='group' aria-label='手记分类' hidden)
              button.is-active(type='button' data-filter='all' aria-pressed='true') 全部
              button(type='button' data-filter='study' aria-pressed='false') 学习
              button(type='button' data-filter='life' aria-pressed='false') 日常
              if rows.some(p => p.kind === 'moment')
                button(type='button' data-filter='moment' aria-pressed='false') 碎碎念
          p.moonlit-filter-status.sr-only(role='status' aria-live='polite')
          ol#recent-posts.moonlit-list
            each post in rows
              li.moonlit-card.moonlit-row(data-kind=post.kind)
                time(datetime=post.iso)= post.file === 'check_in.md' ? '随手' : post.date
                .moonlit-row-copy
                  h3
                    a(href=post.href)= post.title
                  p= post.summary
                span.moonlit-topic= post.topic
          .moonlit-notes-foot
            button.moonlit-more(type='button' hidden) 显示更多
            a.moonlit-head-link(href=url_for('/archives/'))
              | 全部归档
              +icon('right', 15)
      include footer.pug
    include ../../node_modules/hexo-theme-butterfly/layout/includes/rightside.pug
    include ../../node_modules/hexo-theme-butterfly/layout/includes/additional-js.pug
