- var globalPageType = 'home'
- var pageType = 'page'
- var moonlit = site.data.moonlit
- var allNotes = moonlit_posts()
- var notes = allNotes.filter(p => !p.japanese)
- var japaneseNotes = allNotes.filter(p => p.japanese).slice(0, 3)
doctype html
html(lang=config.language data-theme=theme.display_mode)
  head
    include ../../node_modules/hexo-theme-butterfly/layout/includes/head.pug
    link(rel='preload' as='image' href=url_for('/img/moonlit/hero.webp'))
  body.moonlit-home
    != partial('includes/loading/index', {}, {cache: true})
    != partial('includes/sidebar', {}, {cache: true})
    a.moonlit-skip(href='#notes') 跳到手记
    #body-wrap.page
      header#page-header.moonlit-hero
        .moonlit-scene(aria-hidden='true')
        .moonlit-wash(aria-hidden='true')
        .moonlit-stars(aria-hidden='true')
          each n in [1, 2, 3, 4, 5, 6]
            span
        include navigation.pug
        .moonlit-hero-inner
          .moonlit-hero-copy
            p.moonlit-eyebrow MOONLIT NOTES
            h1 在月光下，
              br
              | 记录一些小事。
            p.moonlit-intro= moonlit.intro
            a.moonlit-hero-link(href='#notes') 翻开我的手记
              span(aria-hidden='true') ↓
        .moonlit-hero-caption(aria-hidden='true') SOMEWHERE BETWEEN DAYDREAMS & DAILY LIFE
      main#content-inner.layout.moonlit-layout
        .moonlit-notice
          span.moonlit-notice-label 小站便笺
          span= moonlit.notice
          span.moonlit-notice-star(aria-hidden='true') ✧
        section.moonlit-japanese(aria-label='最近的日语学习')
          .moonlit-japanese-heading
            span(aria-hidden='true') あ
            div
              h2 日语学习日记
              p 每天学到的词语，和一点点进步。
            a(href=url_for('/topics/japanese/')) 翻开专栏 ↗
          if japaneseNotes.length
            .moonlit-japanese-latest
              each post in japaneseNotes
                a(href=post.href)
                  time= post.date
                  strong= post.title
          else
            p.moonlit-japanese-empty 正在开始日语学习，新的记录会收在这里。
        .moonlit-columns
          section#notes.moonlit-notes(aria-labelledby='notes-title')
            .moonlit-section-head
              div
                p.moonlit-eyebrow THE NOTEBOOK
                h2#notes-title 最近的手记
              .moonlit-filters(aria-label='手记分类' hidden)
                button.is-active(type='button' data-filter='all' aria-pressed='true') 全部
                button(type='button' data-filter='study' aria-pressed='false') 学习
                button(type='button' data-filter='life' aria-pressed='false') 日常
            p.moonlit-filter-status.sr-only(role='status' aria-live='polite')
            #recent-posts.moonlit-posts
              each post in notes
                article.moonlit-card(class=(post.featured ? 'moonlit-featured ' : '') + (post.cover ? 'moonlit-illustrated' : 'moonlit-text-note') data-kind=post.kind)
                  if post.cover
                    a.moonlit-cover(href=post.href tabindex='-1' aria-hidden='true')
                      img(src=post.cover alt='' loading='lazy' decoding='async' width='760' height='480')
                      if post.featured
                        span.moonlit-cover-badge 精选手记
                  .moonlit-card-copy
                    .moonlit-meta
                      span.moonlit-topic= post.topic
                      span= post.date
                    h3
                      a(href=post.href)= post.title
                    p= post.summary
                    if post.words >= 300
                      .moonlit-card-reading= '约 ' + post.words + ' 字 · 参考阅读时间 ' + post.minutes + ' 分钟'
                    a.moonlit-read(href=post.href aria-label='阅读：' + post.title) 阅读手记
                      span(aria-hidden='true') ↗
            button.moonlit-more(type='button' hidden) 再翻几页
          aside#aside-content.moonlit-aside(aria-label='关于小站')
            .moonlit-profile
              .moonlit-profile-top(aria-hidden='true')
              img.moonlit-avatar(src=url_for('/img/moonlit/avatar.webp') alt='Catailor 的头像' width='84' height='84')
              p.moonlit-profile-name Catailor
              p.moonlit-profile-en A LITTLE CORNER OF MY WORLD
              p.moonlit-profile-bio= moonlit.bio
              .moonlit-stats
                a(href=url_for('/archives/'))
                  strong= site.posts.length
                  span 手记
                a(href=url_for('/categories/'))
                  strong= site.categories.length
                  span 分类
                a(href=url_for('/tags/'))
                  strong= site.tags.length
                  span 标签
              if site.data.notebook.now.learning
                .moonlit-profile-now
                  h3 最近在学
                  p= site.data.notebook.now.learning
              .moonlit-profile-links
                a(href=url_for('/about/')) 了解更多 →
                a(href='https://github.com/catailor' target='_blank' rel='noopener noreferrer') GitHub ↗
      footer#footer.moonlit-footer
        != partial('includes/footer', {}, {cache: true})
    include ../../node_modules/hexo-theme-butterfly/layout/includes/rightside.pug
    include ../../node_modules/hexo-theme-butterfly/layout/includes/additional-js.pug
